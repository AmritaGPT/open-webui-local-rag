# =========================================================================
# OPEN WEBUI & NVIDIA NIM DEPLOYMENT CONFIGURATION FOR COLLEGE PORTAL
# =========================================================================

# -------------------------------------------------------------------------
# 1. System Ports and Security Keys
# -------------------------------------------------------------------------
# Port on which the Open WebUI interface will be accessible (e.g. http://localhost:8080)
HOST_PORT=8080

# Critical: Generate a secure random string for signing user sessions.
# You can generate one using: openssl rand -hex 32
WEBUI_SECRET_KEY=replace-with-a-secure-random-32-byte-hex-string

# -------------------------------------------------------------------------
# 2. NVIDIA NIM / Build API Configuration
# -------------------------------------------------------------------------
# Your NVIDIA NGC API key from build.nvidia.com
# Open WebUI will automatically pull all available NIM models using this key.
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# -------------------------------------------------------------------------
# 3. Database Credentials (PostgreSQL with pgvector for production-scale RAG)
# -------------------------------------------------------------------------
DB_USER=webui
DB_PASSWORD=choose-a-strong-database-password-here
DB_NAME=openwebui

# -------------------------------------------------------------------------
# 4. User Access and Registration Policies
# -------------------------------------------------------------------------
# Set to 'true' to allow users to sign up themselves.
# Set to 'false' if admins must create all user accounts manually.
ENABLE_SIGNUP=true

# Set default role for new users.
# Options: 'user', 'admin', 'pending'
# 'pending' is highly recommended for college setups: new registrations must be approved by an administrator before access is granted.
DEFAULT_USER_ROLE=pending

# -------------------------------------------------------------------------
# 5. Single Sign-On (SSO) / OIDC Configuration
# -------------------------------------------------------------------------
# If your college uses Google Workspace, Microsoft Entra ID (Azure AD), or Keycloak, 
# you can enable OIDC SSO to allow staff and students to sign in automatically.
ENABLE_OAUTH_SIGNUP=false

# OIDC client credentials from your Identity Provider
OAUTH_CLIENT_ID=your-sso-client-id
OAUTH_CLIENT_SECRET=your-sso-client-secret

# Well-known configuration URL for your OIDC provider
# Google: https://accounts.google.com/.well-known/openid-configuration
# Microsoft Entra: https://login.microsoftonline.com/<tenant-id>/v2.0/.well-known/openid-configuration
# Keycloak: http://<keycloak-host>/realms/<realm-name>/.well-known/openid-configuration
OPENID_PROVIDER_URL=https://your-idp.com/.well-known/openid-configuration
